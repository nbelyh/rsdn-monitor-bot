# RSDN Bot Configuration
# Copy this file to .env and fill in your actual values

# REQUIRED: Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# RSDN API Credentials (REQUIRED for API mode)
# Register at https://rsdn.org if you don't have an account
RSDN_USERNAME=your_rsdn_username
RSDN_PASSWORD=your_rsdn_password

# API Mode Toggle (true = use SOAP API, false = use HTML scraper)
USE_API_CLIENT=false

# Scraping settings
CHECK_INTERVAL_MINUTES=1
RSDN_URL=https://rsdn.org

# Database
DATABASE_FILE=rsdn_messages.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=rsdn_bot.log

# Optional: Filter specific forums (comma-separated)
# Leave empty to monitor all forums
# Examples: network,life,flame.comp,abroad,humour
MONITORED_FORUMS=